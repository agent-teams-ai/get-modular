{
  "name": "@get-modular/assembly",
  "version": "0.1.0",
  "description": "Host-owned sequential construction above Get Modular Core.",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-teams-ai/get-modular.git",
    "directory": "packages/assembly"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "node ../../architecture/tooling/build-assembly.mjs",
    "typecheck": "tsc -p tsconfig.types.json && tsc -p tsconfig.types.bundler.json",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@get-modular/core": "workspace:*"
  }
}
