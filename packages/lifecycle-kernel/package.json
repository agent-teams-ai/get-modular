  "private": true,
  "description": "Pure executable generation and lease bookkeeping for product Hosts.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.18.0 <25 || >=26.10.0 <27"
  },
  "exports": {
