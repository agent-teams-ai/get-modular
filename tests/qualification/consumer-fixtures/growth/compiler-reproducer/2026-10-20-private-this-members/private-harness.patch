+// Disposable compiler-owner experiment only; no supported compiler adoption.
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { readFile } from "node:fs/promises";
+import { isAbsolute } from "node:path";
+import { upstreamSelection } from "./upstream-compiler.ts";
+
+const goSelection = Object.freeze({
+  version: "go1.27.2",
+  archiveSha256: "ecbadb99091a3f46e31f5f934b068b1864eafa7995211b39eaddf76996045fe5",
+});
+const expectedPatchSha256 = "3a98de8a169b239da38cbe285de2f88e498406b8bdc24eec4685d6b4809a308e";
+const expectedBinarySha256 = "061c589fd01523d69ca6bb74d74e6331b6092a14ee286bd60f11d7a51eeb9e66";
+
+interface PatchedCandidateManifest {
+  readonly kind: "private-compiler-owner-patch";
+  readonly source: typeof upstreamSelection;
+  readonly go: typeof goSelection;
+  readonly patchPath: string;
+  readonly patchSha256: string;
+  readonly cli: string;
+  readonly version: "7.1.0-dev";
+  readonly binarySha256: string;
+}
+
+const hash = (bytes: Uint8Array): string => createHash("sha256").update(bytes).digest("hex");
+
+/** Verifies the one explicitly selected private patch and native binary, without installing either. */
+export async function readPatchedCandidate(path: string): Promise<PatchedCandidateManifest & { readonly manifestSha256: string }> {
+  assert.ok(isAbsolute(path), "fixture.growth.private-manifest-path");
+  const bytes = await readFile(path);
+  const candidate = JSON.parse(bytes.toString("utf8")) as PatchedCandidateManifest;
+  assert.equal(candidate.kind, "private-compiler-owner-patch");
+  assert.deepEqual(candidate.source, upstreamSelection);
+  assert.deepEqual(candidate.go, goSelection);
+  assert.equal(candidate.version, "7.1.0-dev");
+  assert.ok(isAbsolute(candidate.patchPath), "fixture.growth.private-patch-path");
+  assert.equal(candidate.patchSha256, expectedPatchSha256, "fixture.growth.private-patch-selection");
+  assert.equal(hash(await readFile(candidate.patchPath)), expectedPatchSha256, "fixture.growth.private-patch-drift");
+  assert.ok(isAbsolute(candidate.cli), "fixture.growth.private-binary-path");
+  assert.equal(candidate.binarySha256, expectedBinarySha256, "fixture.growth.private-binary-selection");
+  assert.equal(hash(await readFile(candidate.cli)), expectedBinarySha256, "fixture.growth.private-binary-drift");
+  return { ...candidate, manifestSha256: hash(bytes) };
+}
