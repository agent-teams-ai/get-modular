* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary

# Language statistics describe the published TypeScript library, not its
# qualification suites and repository tooling. These files stay tracked and
# visible in diffs with their original syntax highlighting.
/tests/** -linguist-detectable
/packages/*/tests/** -linguist-detectable
/architecture/checks/** -linguist-detectable
/architecture/tooling/** -linguist-detectable

# Retained generated observations keep their original bytes and remain inspectable.
/tests/qualification/consumer-fixtures/growth/source-evidence/** linguist-generated=true

# Raw retained Git patches include space-prefixed context and preserve exact bytes.
/architecture/sdk-growth/evidence/cms-guidance-descriptor-unions-bun-20261025/common-assembly.diff -whitespace
/architecture/sdk-growth/evidence/cms-guidance-descriptor-unions-bun-20261025/growth-common-assembly.diff -whitespace
